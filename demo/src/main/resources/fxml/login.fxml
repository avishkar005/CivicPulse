<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.LoginController">

    <StackPane AnchorPane.topAnchor="0"
               AnchorPane.bottomAnchor="0"
               AnchorPane.leftAnchor="0"
               AnchorPane.rightAnchor="0"
               styleClass="auth-container">

        <!-- 🔥 IMPORTANT FIX: mouseTransparent MUST be false -->
        <VBox spacing="18"
              alignment="CENTER"
              maxWidth="360"
              mouseTransparent="false">

            <Label text="CivicPulse" styleClass="app-title"/>
            <Label text="Welcome back" styleClass="subtitle"/>

            <TextField fx:id="emailField"
                       promptText="Email"
                       maxWidth="300"/>

            <PasswordField fx:id="passwordField"
                           promptText="Password"
                           maxWidth="300"/>

            <Button text="Login"
                    styleClass="primary-btn"
                    maxWidth="300"
                    onAction="#handleLogin"/>

            <Button text="Continue with Google"
                    styleClass="secondary-btn"
                    maxWidth="300"
                    onAction="#handleGoogleLogin"/>

            <Separator maxWidth="300"/>

            <!-- 🔥 FIXED: clickable hyperlink -->
            <Hyperlink text="Create new account"
                       underline="true"
                       onAction="#goToRegister"/>

        </VBox>

    </StackPane>
</AnchorPane>
