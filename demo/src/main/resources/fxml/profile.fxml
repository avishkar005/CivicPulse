<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<HBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      spacing="30"
      styleClass="content-pane">

    <!-- LEFT PROFILE INFO -->
    <VBox spacing="14" prefWidth="360">

        <Label text="Profile" styleClass="section-title"/>
        <Label text="User Information" styleClass="sub-heading"/>

        <VBox styleClass="card" spacing="10">
            <Label text="Name" styleClass="profile-label"/>
            <Label text="Avishkar Choundkar" styleClass="profile-value"/>

            <Label text="Email" styleClass="profile-label"/>
            <Label text="avishkarchoundkar@gmail.com"
                   styleClass="profile-value"/>
        </VBox>

        <Button text="Logout"
                styleClass="danger-btn"
                prefWidth="120"/>
    </VBox>

    <!-- RIGHT CONTENT -->
    <VBox spacing="20" HBox.hgrow="ALWAYS">

        <!-- USER SUMMARY -->
        <VBox styleClass="card" spacing="8">
            <Label text="👋 Welcome back, Avishkar"
                   styleClass="section-title"/>
            <Label text="Thanks for helping improve your city through CivicPulse."
                   styleClass="sub-heading"/>
        </VBox>

        <!-- IMPACT STATS -->
        <HBox spacing="16">
            <VBox styleClass="card" prefWidth="180">
                <Label text="Total Reports" styleClass="profile-label"/>
                <Label text="5" styleClass="profile-value"/>
            </VBox>

            <VBox styleClass="card" prefWidth="180">
                <Label text="Resolved" styleClass="profile-label"/>
                <Label text="2" styleClass="profile-value"/>
            </VBox>

            <VBox styleClass="card" prefWidth="180">
                <Label text="Pending" styleClass="profile-label"/>
                <Label text="3" styleClass="profile-value"/>
            </VBox>
        </HBox>

        <!-- RECENT ACTIVITY -->
        <VBox styleClass="card" spacing="10">
            <Label text="Recent Activity"
                   styleClass="section-title"/>

            <Label text="• Garbage issue reported in Kothrud"
                   styleClass="sub-heading"/>

            <Label text="• Street light issue marked resolved"
                   styleClass="sub-heading"/>

            <Label text="• Water leakage issue under review"
                   styleClass="sub-heading"/>
        </VBox>

        <!-- TRUST / INFO -->
        <VBox styleClass="card" spacing="8">
            <Label text="Your Impact Matters"
                   styleClass="section-title"/>

            <Label text="Each report you submit helps authorities\nidentify, track, and resolve civic problems faster."
                   styleClass="sub-heading"/>
        </VBox>

    </VBox>

</HBox>
